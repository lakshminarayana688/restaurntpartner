# ============================================================================
# FEEDO RESTAURANT PARTNER — ENVIRONMENT CONFIGURATION
# Free-Tier Production & Development Environment Variables
# ============================================================================

# 1. Frontend Supabase Client (Safe to expose in Vite client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# 2. Supabase Server / Edge Functions Secrets (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY
KYC_ENCRYPTION_KEY=YOUR_32_CHAR_RANDOM_AES_KEY_FOR_KYC
BANK_ENCRYPTION_KEY=YOUR_32_CHAR_RANDOM_AES_KEY_FOR_BANK
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_GATEWAY_WEBHOOK_SECRET

# 3. Firebase Cloud Messaging (FCM Push Notifications Backend)
FCM_PROJECT_ID=feedo-partner-prod
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"feedo-partner-prod",...}

# 4. Optional External Services
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
